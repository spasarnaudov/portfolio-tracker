/build

# Android Studio's "Generate Signed Bundle/APK" wizard defaults its output
# folder to <module>/<flavor>/<buildType> (e.g. /beta/release/*.aab) — outside
# /build, so it isn't covered by the rule above.
/alpha
/beta
/production

# A stray nested IDE project — this module has no business having its own
# .idea; the real project root is apps/android, one level up.
/.idea